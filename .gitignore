# ==========================================
# HelixFlow - Root .gitignore
# ==========================================

# Dependencies & Build Outputs
node_modules/
dist/
dist-ssr/
.vite/
target/
*.class
*.jar
*.war
*.ear
*.nar

# Maven Wrapper & Cache
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Logs & Temporary Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.bak

# Environment & Secret Files
.env
.env.*
!.env.example
*.local

# IDE & Editor Configurations
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
